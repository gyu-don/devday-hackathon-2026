{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "devday-hackathon-2026",
  "account_id": "9d0172593244e79ac489839342f65d9d",
  "workers_dev": true,
  "main": "src/index.ts",
  "compatibility_date": "2026-10-18",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../game/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/mcp"],
  },
  "durable_objects": {
    "bindings": [{ "name": "GAME_EVENTS", "class_name": "GameEventStore" }],
  },
  "migrations": [{ "tag": "v1-game-events", "new_sqlite_classes": ["GameEventStore"] }],
  "vars": { "MCP_CALLBACK_ORIGINS": "" },
  "secrets": { "required": ["OPENAI_API_KEY"] },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true },
    "traces": { "enabled": true },
  },
}
